<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/averyPicture"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/avery"
            android:contentDescription="@string/picture_of_avery_adams"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avery Adams"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#243B53"
            android:padding="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Address: 4555 Cent Avenue, Pinehurst, NC"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_540_555_0102"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: avery.adams@email.com"
            android:textSize="16sp"
            android:padding="10dp" />

        <Button
            android:id="@+id/averyBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Contacts" />

    </LinearLayout>
</ScrollView>
