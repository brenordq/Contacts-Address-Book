<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Breanna Gonzalez - Contacts Address Book"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#243B53"
            android:gravity="center"
            android:padding="16dp" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:text="A"
            android:textColor="#334E68"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="187dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Alex Anderson"
            android:textColor="#243B53"
            android:textSize="18sp" />

        <Button
            android:id="@+id/alexDetailsButton"
            android:layout_width="187dp"
            android:layout_height="wrap_content"
            android:text="View Alex's Details" />

        <TextView
            android:layout_width="187dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Avery Adams"
            android:textColor="#243B53"
            android:textSize="18sp" />

        <Button
            android:id="@+id/averyDetailsButton"
            android:layout_width="187dp"
            android:layout_height="wrap_content"
            android:text="View Avery's Details" />

    </LinearLayout>
</ScrollView>
