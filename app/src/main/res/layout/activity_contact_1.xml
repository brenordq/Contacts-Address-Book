<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/alexPicture"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/alex"
            android:contentDescription="@string/picture_of_alex_anderson"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alex_anderson"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#243B53"
            android:padding="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/address_123_fake_street_vass_nc"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_910_555_1111"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email_alex_anderson_email_com"
            android:textSize="16sp"
            android:padding="10dp" />

        <Button
            android:id="@+id/alexBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_contacts" />

    </LinearLayout>
</ScrollView>
